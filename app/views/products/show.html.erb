<div class="max-w-4xl mx-auto px-4 py-12">
  <!-- Кнопка назад -->
  <div class="mb-6">
    <%= link_to products_path, class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-indigo-600 transition" do %>
      <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Назад к списку товаров
    <% end %>
  </div>

  <!-- Главный блок карточки -->
  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden md:flex">
    
    <!-- Левая часть: Место для будущей картинки -->
    <div class="md:w-1/2 bg-gray-100 h-64 md:h-auto flex items-center justify-center text-gray-400">
      <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-20 h-20">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V6.75z" />
      </svg>
    </div>

    <!-- Правая часть: Информация -->
    <div class="p-8 md:w-1/2 flex flex-col justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-4"><%= @product.name %></h1>
        
        <!-- Блок цены -->
        <div class="mb-6">
          <span class="text-2xl font-extrabold text-indigo-600">
            <%= @product.price.present? ? "#{@product.price} ₽" : "Цена не указана" %>
          </span>
        </div>

        <!-- Дополнительная информация -->
        <div class="border-t border-gray-100 pt-4 space-y-2 text-sm text-gray-500">
          <p>ID товара: <span class="font-mono text-gray-700">#<%= @product.id %></span></p>
          <p>Добавлен: <span class="text-gray-700"><%= @product.created_at.strftime("%d.%m.%Y в %H:%M") %></span></p>
        </div>
      </div>

      <!-- Кнопки действий (на будущее) -->
      <div class="mt-8 flex space-x-3">
        <button class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 px-4 rounded-xl transition text-center text-sm shadow-sm">
          Купить
        </button>
        <button class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2.5 px-4 rounded-xl transition text-sm">
          Редактировать
        </button>
      </div>
    </div>

  </div>
</div>
