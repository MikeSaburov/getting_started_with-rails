<h1>Наш магазин товаров</h1>

<ul>
  <% @products.each do |product| %>
    <!-- Передаем сам объект product в метод link_to, и Rails сам поймет, какой у него ID, 
  и в какой путь этот продукт нужно передать -->
    <p><strong><%= link_to product.name, product_path(product) %></strong></p> 
  <% end %>

</ul>
<br>
<%= link_to "Добавить новый товар", new_product_path %>